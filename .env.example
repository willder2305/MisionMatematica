# Backend
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tesis_matematica_app

JWT_SECRET_KEY=change-this-secret
JWT_ACCESS_EXPIRES=900
JWT_REFRESH_EXPIRES=604800
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=240

MAIL_HOST=
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@misionmatematica.local

FRONTEND_URLS=http://127.0.0.1:5173,http://localhost:5173
APP_ENV=development
FLASK_DEBUG=false
TRUST_PROXY_HEADERS=false

# Gunicorn en Linux; no son necesarios para ejecutar app.py en Windows.
GUNICORN_BIND=127.0.0.1:8000
GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60

# Frontend
VITE_API_URL=http://127.0.0.1:5000/api
