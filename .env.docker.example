# Copiar como .env y reemplazar todos los valores CAMBIAR_ antes de producción.
MYSQL_DATABASE=tesis_matematica_app
MYSQL_USER=mision_user
MYSQL_PASSWORD=CAMBIAR_PASSWORD_DB
MYSQL_ROOT_PASSWORD=CAMBIAR_ROOT_PASSWORD_DB

# La red de Docker resuelve el nombre del servicio; no usar localhost aquí.
DB_HOST=db
DB_PORT=3306

APP_ENV=production
FLASK_DEBUG=false
JWT_SECRET_KEY=CAMBIAR_SECRET_JWT_LARGO_Y_ALEATORIO
FRONTEND_URLS=https://misionmatematica.com,https://www.misionmatematica.com
TRUST_PROXY_HEADERS=true
PRIMARY_DOMAIN=misionmatematica.com
WWW_DOMAIN=www.misionmatematica.com
LETSENCRYPT_EMAIL=CAMBIAR_CORREO_ADMIN
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_API_PER_MINUTE=240

GUNICORN_WORKERS=2
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60

# Se incorpora al build de React; nunca colocar secretos en VITE_*.
VITE_API_URL=/api
